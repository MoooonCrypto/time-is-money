# Copy to .env.local (gitignored) and fill in. Read by app.config.ts / config/ids.js.
# Main app bundle identifier. Extensions use <this>.monitor/.shieldconfig/.shieldaction/.report
# and the App Group is group.<this>.
TIM_BUNDLE_ID=com.example.timeismoney
# Apple Developer Team ID (Xcode > Signing & Capabilities). Never commit the real value.
APPLE_TEAM_ID=
# Development only: in-memory mock of the Screen Time module for UI inspection without iOS.
# EXPO_PUBLIC_TIM_MOCK=1
